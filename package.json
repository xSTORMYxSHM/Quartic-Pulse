{
  "name": "quartic-pulse",
  "version": "1.0.5",
  "releaseChannel": "stable",
  "description": "A Windows 11 audio-reactive fractal visualizer and music-to-video exporter.",
  "main": "src/main/main.js",
  "author": "Tempest Mainframe",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/ensure-electron-runtime.ps1",
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/release-gate.ps1 -Quick",
    "test:unit": "node --test src/main/tests/visualizer-package-manager.test.js src/main/tests/security-policy.test.js src/main/tests/update-service.test.js tools/report-relay/tests/report-core.test.js tools/report-relay/tests/quartic-report.test.js",
    "test:release": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/release-gate.ps1",
    "test:controllers": "set ELECTRON_RUN_AS_NODE=1&& electron tools/controller-smoke.js",
    "sync:data-horizon": "node tools/sync-data-horizon-runtime.js",
    "icon": "electron tools/render-icon.js",
    "bundle:ffmpeg": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/prepare-ffmpeg.ps1",
    "pack": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-release.ps1 -DirectoryOnly",
    "dist": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-release.ps1"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.tempestmainframe.quarticpulse",
    "productName": "Quartic Pulse",
    "asar": true,
    "asarUnpack": [
      "assets/windows-audio/**/*",
      "assets/spout/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "!assets/bin/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "BRAND_ASSETS.md"
    ],
    "extraResources": [
      {
        "from": "assets/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "BRAND_ASSETS.md",
        "to": "BRAND_ASSETS.md"
      },
      {
        "from": "tools/fixtures/data-horizon-signal-test",
        "to": "smoke-fixtures/data-horizon-signal-test"
      }
    ],
    "win": {
      "icon": "assets/icon.png",
      "verifyUpdateCodeSignature": true,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "Quartic.Pulse.Setup.${version}.${ext}",
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "installerHeader": "assets/installer/installer-header.bmp",
      "installerSidebar": "assets/installer/installer-sidebar.bmp",
      "uninstallerSidebar": "assets/installer/installer-sidebar.bmp",
      "include": "assets/installer/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "Quartic.Pulse.Portable.${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "xSTORMYxSHM",
        "repo": "Quartic-Pulse"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
